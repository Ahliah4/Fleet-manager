{
  "name": "@ip-motors/fleet-api",
  "version": "0.1.0",
  "private": true,
  "description": "IP Motors Fleet Manager API foundation",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:gateway-auth": "AUTH_ISSUER=http://localhost:3001 AUTH_AUDIENCE=http://localhost:3001 AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:apply": "tsx scripts/migrate.ts --apply",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "migrate:reconcile-0004": "tsx scripts/reconcile-migration.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@neondatabase/serverless": "^1.2.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
