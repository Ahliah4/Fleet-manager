# Copy this file to backend/.env and replace every placeholder.
# Never commit .env. Never put Neon credentials in a client app.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# API connection. Use the migration-created non-owner role named app_rw.
# Keep DATABASE_EXPECTED_ROLE=app_rw; the migrations grant privileges to this role.
DATABASE_URL=postgresql://app_rw:REPLACE_ME@REPLACE_ME-pooler.REPLACE_ME.neon.tech/REPLACE_ME?sslmode=require
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_EXPECTED_ROLE=app_rw

# Migration connection. Use the development branch owner/direct connection.
# Never point this at the Neon production branch.
MIGRATION_DATABASE_URL=postgresql://REPLACE_ME_OWNER:REPLACE_ME@REPLACE_ME.REPLACE_ME.neon.tech/REPLACE_ME?sslmode=require

# Provider-neutral OIDC/JWT verification boundary.
# Leave all three blank to keep protected routes disabled (fail closed).
# Configure all three together when the identity provider is selected.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_CLOCK_TOLERANCE_SECONDS=30

# Optional comma-separated list of trusted proxy addresses for Fastify.
TRUST_PROXY=
