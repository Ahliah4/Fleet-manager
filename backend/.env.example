# Copy to backend/.env and fill in locally. Never commit real values.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Required server-side database connection; use only Neon development.
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_EXPECTED_ROLE=app_rw

# Migration-only direct connection for the development branch.
MIGRATION_DATABASE_URL=

# Leave all three blank to keep protected API routes disabled (fail closed).
# For the mobile gateway flow, these point to the deployed gateway origin and
# /.well-known/jwks.json. Keep them server-side; do not put them in Flutter.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_CLOCK_TOLERANCE_SECONDS=30
TRUST_PROXY=
