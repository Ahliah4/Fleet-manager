# Development branch only. Copy the full Managed Better Auth URL from Neon.
NEON_AUTH_BASE_URL=

# Generate locally with: openssl rand -base64 32
# Do not commit the real value.
NEON_AUTH_COOKIE_SECRET=

# Native mobile handoff. Keep these values server-side.
# Comma-separated exact callback URIs, e.g. an HTTPS App Link and a local dev scheme.
MOBILE_REDIRECT_URIS=

# Gateway-issued EdDSA access-token configuration.
GATEWAY_JWT_ISSUER=
GATEWAY_JWT_AUDIENCE=
GATEWAY_JWT_PRIVATE_JWK=
GATEWAY_JWT_PUBLIC_JWK=

# `memory` is local Next.js development only and is rejected in production.
# Cloudflare staging/release uses the bound SQLite Durable Object.
MOBILE_FLOW_STORAGE=memory

# Release App Link / Universal Link verification. Leave blank locally; the
# gateway returns 404 instead of publishing a half-configured association.
IOS_APP_TEAM_ID=
IOS_BUNDLE_ID=
ANDROID_APP_PACKAGE=
# Comma-separated SHA-256 fingerprints from the release signing certificate.
ANDROID_SHA256_CERT_FINGERPRINTS=
