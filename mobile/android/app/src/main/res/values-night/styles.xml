<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The product uses a light, warm workspace in every system appearance. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">#0B0B0C</item>
        <item name="android:navigationBarColor">#0B0B0C</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#F4F4F1</item>
        <item name="android:statusBarColor">#F4F4F1</item>
        <item name="android:navigationBarColor">#F4F4F1</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
