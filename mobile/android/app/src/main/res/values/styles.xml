<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">#0B0B0C</item>
        <item name="android:navigationBarColor">#0B0B0C</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <!-- Theme applied after the engine starts. Keeps the background warm while
         Flutter draws its first frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#F4F4F1</item>
        <item name="android:statusBarColor">#F4F4F1</item>
        <item name="android:navigationBarColor">#F4F4F1</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
